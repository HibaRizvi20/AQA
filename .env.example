# The app under test. Both are required; the pipeline refuses to start without them.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Optional. Without these, any contract that needs a token is reported as SKIPPED with that
# reason — never as a pass. Set both or neither.
TEST_USERNAME=
TEST_PASSWORD=

# Optional. Without these the Tracker Publisher stays in dry-run and only emits payloads.
TRACKER_BASE_URL=
TRACKER_TOKEN=

# Optional, with defaults.
REQUEST_TIMEOUT_MS=10000
PERF_ITERATIONS=20
